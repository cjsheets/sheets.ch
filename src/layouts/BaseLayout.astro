---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  headerTitle?: string;
}

const { title, description = 'Notes, projects, and work by software engineer Chad Sheets.', headerTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | sheets.ch</title>
  </head>
  <body>
    <Header pageTitle={headerTitle} />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-main {
    padding-top: 4.5rem;
    min-height: 60vh;
  }

  @media (max-width: 560px) {
    .site-main { padding-top: 2.4rem; }
  }
</style>
