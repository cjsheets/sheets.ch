---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, date, updated, tags = [], headings } = Astro.props;
const formatDate = (value: Date) => value.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <div class="post-layout container--wide">
    <article class="post-content">
      <header class="post-header">
        <p class="eyebrow"><a href="/posts">Notes</a></p>
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span> · Updated {formatDate(updated)}</span>}
        </div>
        {tags.length > 0 && <ul class="post-tags" aria-label="Topics">{tags.map((tag) => <li>{tag}</li>)}</ul>}
      </header>
      <div class="prose"><slot /></div>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .post-layout { display: grid; grid-template-columns: minmax(0, 44rem) 12rem; justify-content: center; gap: 3rem; align-items: start; }
  .post-content { min-width: 0; }
  .post-header { margin-bottom: 2.3rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--color-border); }
  .eyebrow { margin: 0 0 0.6rem; color: var(--color-accent); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .post-header h1 { max-width: 40rem; }
  .post-meta { color: var(--color-text-muted); font-family: var(--font-sans); font-size: 0.75rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.35rem 0.75rem; margin: 0.7rem 0 0; padding: 0; list-style: none; color: var(--color-text-muted); font-family: var(--font-sans); font-size: 0.68rem; }
  .post-tags li { margin: 0; }
  .prose :global(h2) { margin-top: 2.8rem; }
  .prose :global(h3) { margin-top: 1.9rem; }
  .prose :global(a) { text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent); }
  @media (max-width: 980px) { .post-layout { grid-template-columns: minmax(0, 44rem); } }
</style>
