---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, date, updated, tags = [], headings } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} contentMode={true}>
  <div class="post-layout container--wide">
    <article class="post-content container">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
          {updated && (
            <span class="post-meta__updated">
              &middot; Updated {formatDate(updated)}
            </span>
          )}
        </div>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 3rem;
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    align-items: start;
  }

  .post-content {
    min-width: 0;
    overflow: hidden;
    padding: 0;
    margin: 0;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .post-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-meta__updated {
    color: var(--color-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2em 0.65em;
    background: var(--color-code-bg);
    color: var(--color-text-secondary);
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Prose styles for rendered markdown */
  .prose :global(h2) {
    margin-top: 2.5em;
    padding-top: 1em;
    border-top: 1px solid var(--color-border);
  }

  .prose :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(26, 115, 232, 0.3);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  @media (max-width: 1100px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
