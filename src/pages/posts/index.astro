---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Group posts by year
const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Posts" description="Articles about software development and technology.">
  <div class="container">
    <header class="page-header">
      <h1>Posts</h1>
      <p class="page-subtitle">Thoughts on development, technology, and what I'm learning.</p>
    </header>

    {years.map((year) => (
      <section class="year-section">
        <h2 class="year-label">{year}</h2>
        <ul class="post-list" role="list">
          {postsByYear[year].map((post) => (
            <li class="post-list__item">
              <a href={`/posts/${post.id}`} class="post-list__link">
                <span class="post-list__title">{post.data.title}</span>
                <time class="post-list__date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 0 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .year-section {
    margin-top: 2rem;
  }

  .year-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    margin-top: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list__link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .post-list__link:hover {
    background: var(--color-code-bg);
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
    border-radius: 6px;
  }

  .post-list__title {
    font-weight: 500;
    color: var(--color-text);
  }

  .post-list__date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
