---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume" description="Professional experience, skills, and education.">
  <div class="container">
    <header class="page-header">
      <h1>Resume</h1>
      <p class="page-subtitle">Professional experience and background.</p>
    </header>

    <section class="resume-section">
      <h2>Experience</h2>

      <div class="job">
        <div class="job__header">
          <h3 class="job__title">Senior Software Engineer</h3>
          <span class="job__period">2022 &ndash; Present</span>
        </div>
        <p class="job__company">Acme Corp</p>
        <ul class="job__details">
          <li>Led development of customer-facing web applications using React and TypeScript</li>
          <li>Designed and implemented RESTful APIs with Node.js and PostgreSQL</li>
          <li>Mentored junior developers and established engineering best practices</li>
          <li>Reduced page load times by 40% through performance optimization</li>
        </ul>
      </div>

      <div class="job">
        <div class="job__header">
          <h3 class="job__title">Software Engineer</h3>
          <span class="job__period">2019 &ndash; 2022</span>
        </div>
        <p class="job__company">Tech Startup Inc.</p>
        <ul class="job__details">
          <li>Built full-stack features for a SaaS platform serving 50k+ users</li>
          <li>Implemented CI/CD pipelines and automated testing infrastructure</li>
          <li>Collaborated with design and product teams in an agile environment</li>
        </ul>
      </div>

      <div class="job">
        <div class="job__header">
          <h3 class="job__title">Junior Developer</h3>
          <span class="job__period">2017 &ndash; 2019</span>
        </div>
        <p class="job__company">Web Agency Co.</p>
        <ul class="job__details">
          <li>Developed responsive websites and web applications for clients</li>
          <li>Maintained and improved existing codebases</li>
          <li>Participated in code reviews and knowledge sharing</li>
        </ul>
      </div>
    </section>

    <section class="resume-section">
      <h2>Skills</h2>
      <div class="skills-grid">
        <div class="skill-group">
          <h3>Languages</h3>
          <div class="skill-tags">
            <span class="skill-tag">TypeScript</span>
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">Python</span>
            <span class="skill-tag">SQL</span>
            <span class="skill-tag">HTML/CSS</span>
          </div>
        </div>
        <div class="skill-group">
          <h3>Frameworks</h3>
          <div class="skill-tags">
            <span class="skill-tag">React</span>
            <span class="skill-tag">Node.js</span>
            <span class="skill-tag">Next.js</span>
            <span class="skill-tag">Express</span>
            <span class="skill-tag">Next.js</span>
          </div>
        </div>
        <div class="skill-group">
          <h3>Tools</h3>
          <div class="skill-tags">
            <span class="skill-tag">Git</span>
            <span class="skill-tag">Docker</span>
            <span class="skill-tag">PostgreSQL</span>
            <span class="skill-tag">AWS</span>
            <span class="skill-tag">Linux</span>
          </div>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h2>Education</h2>
      <div class="job">
        <div class="job__header">
          <h3 class="job__title">B.S. Computer Science</h3>
          <span class="job__period">2013 &ndash; 2017</span>
        </div>
        <p class="job__company">University of Technology</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 0 1rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .resume-section {
    margin-top: 2.5rem;
  }

  .resume-section h2 {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .job {
    margin-bottom: 2rem;
  }

  .job__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job__title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }

  .job__period {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .job__company {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .job__details {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    margin: 0;
  }

  .job__details li {
    margin-bottom: 0.25rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .skill-tag {
    font-size: 0.8rem;
    padding: 0.25em 0.65em;
    background: var(--color-code-bg);
    color: var(--color-text-secondary);
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }
</style>
