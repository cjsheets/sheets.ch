---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    when: '2026 –',
    org: 'Commerce Platforms',
    title: 'Principal AI Engineer',
    body: 'Made validation-first AI-assisted engineering the team default: agents generate changes, static analysis and automated tests decide what merges. Hardened authentication redirects, dependency governance, and package-version controls so faster delivery did not loosen security, and ran internal talks and demos showing setup work dropping from weeks to under a day and investigations from hours to minutes.',
  },
  {
    when: '2025 – 2026',
    org: 'Commerce Platforms',
    title: 'Senior AI Engineer',
    body: 'Turned a product-specific assistant into a reusable UI platform for several enterprise workflows, and rewrote a legacy JavaScript backend as a typed, modular TypeScript service. Built the TypeScript monorepo with parallel delivery pipelines and the Playwright foundation that runs visual, unit, and end-to-end checks at pull-request time.',
  },
  {
    when: '2024 – 2025',
    org: 'Microsoft 365 Education',
    title: 'Engineering Manager',
    body: 'Led the UI engineering team through legacy-platform retirement, security commitments, and new AI-assisted learning features while staying hands-on in code, and coached an intern from ramp-up to an accepted return offer. Ran infrastructure and identity migrations with no customer-visible downtime, rebuilt telemetry lost in a platform migration, improved median load time by double digits, and cut the UI backlog roughly in half.',
  },
  {
    when: '2021 – 2024',
    org: 'Microsoft 365 Education',
    title: 'Senior Software Engineer',
    body: 'UI architect for a major Education web app as it grew to millions of monthly users, shipped on schedule with performance budgets and bundle-size gates from the first release. Led UI for the product\'s first generative-AI features (co-inventor on a patent application for AI-assisted assessment generation), built the shared Playwright framework at 99%+ reliability and ~40% less manual validation, and owned threat modeling, CSP, the MSAL auth migration, and the annual service security review.',
  },
  {
    when: '2017 – 2021',
    org: 'Microsoft 365 Education',
    title: 'Software Engineer to Senior Software Engineer',
    body: 'Shipped grading, assessment, content-creation, and Teams-sharing experiences on desktop and mobile, going from contract engineer to UI technical lead. Cut initial script parsing ~40% and build time ~50% on half the memory, kept the product fast through the remote-learning surge, and designed the resource-integration framework that let new learning tools plug in without custom host-app work.',
  },
  {
    when: '2009 – 2017',
    org: 'Schlumberger Wireline',
    title: 'Field Engineer to Senior Field Engineer',
    body: 'Lead engineer for deepwater wireline operations in Louisiana, Angola, and Alaska: $25M+ in revenue over six years with zero serious HSE incidents. Filled in as line manager, technical consultant, and sales engineer on remote projects, and trained local operators, technicians, and engineers in Angola.',
  },
];

const focus = [
  ['Agentic engineering and AI-assisted delivery', 'current'],
  ['TypeScript and web architecture', 'practice'],
  ['Playwright and test-automation architecture', 'systems'],
  ['Web performance, security, and accessibility', 'systems'],
  ['Technical leadership and mentoring', 'teams'],
];
---

<BaseLayout title="Resume" description="Professional experience and background for Chad Sheets.">
  <div class="container">
    <header class="page-header">
      <h1>Resume</h1>
      <p class="page-subtitle">Software engineering, technical leadership, and field operations.</p>
    </header>

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <ol class="experience-list">
        {experience.map((role) => (
          <li>
            <div class="when"><strong>{role.when}</strong><span>{role.org}</span></div>
            <div><h3>{role.title}</h3><p>{role.body}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="focus-heading">
      <h2 id="focus-heading">Focus</h2>
      <ul class="ruled-list" role="list">
        {focus.map(([label, note]) => <li><span>{label}</span><span>{note}</span></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .experience-list { margin: 0; padding: 0; list-style: none; }
  .experience-list > li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; margin: 0; padding: 1.05rem 0; border-top: 1px solid var(--color-border); }
  .experience-list > li:last-child { border-bottom: 1px solid var(--color-border); }
  .when { padding-top: 0.15rem; color: var(--color-text-muted); font-size: 0.78rem; line-height: 1.45; }
  .when strong, .when span { display: block; }
  .when strong { color: var(--color-text); font-weight: 600; }
  .experience-list h3 { margin: 0 0 0.3rem; }
  .experience-list p { margin: 0; color: var(--color-text-secondary); }
  .ruled-list { margin: 0; padding: 0; list-style: none; }
  .ruled-list li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 0; padding: 0.55rem 0; border-top: 1px solid var(--color-border); }
  .ruled-list li:last-child { border-bottom: 1px solid var(--color-border); }
  .ruled-list li span:last-child { flex: none; color: var(--color-text-muted); font-size: 0.72rem; }
  @media (max-width: 560px) { .experience-list > li { grid-template-columns: 1fr; gap: 0.35rem; } .when strong, .when span { display: inline; } .when span::before { content: ' · '; } }
</style>
