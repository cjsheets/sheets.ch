---
const navLinks = [
  { href: '/', label: 'Work' },
  { href: '/posts', label: 'Notes' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header container">
  <a href="/" class="site-header__name">Chad Sheets</a>
  <nav aria-label="Site">
    <ul class="site-header__links" role="list">
      {navLinks.map(({ href, label }) => (
        <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding-top: 3.5rem; padding-bottom: 3.2rem; }
  .site-header__name { flex: none; font-size: 1.3rem; font-weight: 500; letter-spacing: -0.015em; text-decoration: none; }
  .site-header__links { display: flex; flex-wrap: wrap; gap: 1.35rem; margin: 0; padding: 0; list-style: none; font-size: 0.92rem; }
  .site-header__links li { margin: 0; }
  .site-header__links a { color: var(--color-text); }
  .site-header__links a[aria-current='page'] { text-decoration-color: var(--color-accent); }
  @media (max-width: 560px) {
    .site-header { align-items: flex-start; padding-top: 2.25rem; padding-bottom: 2.4rem; }
    .site-header__links { max-width: 11rem; justify-content: flex-end; gap: 0.4rem 1rem; }
  }
</style>
